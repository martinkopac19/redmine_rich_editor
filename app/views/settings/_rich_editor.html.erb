<div class="box tabular settings">
  <p>
    <label for="enabled"><%= l(:re_setting_enabled) %></label>
    <%= hidden_field_tag 'settings[enabled]', '0', id: nil %>
    <%= check_box_tag 'settings[enabled]', '1', settings['enabled'].to_s != '0' %>
    <em class="info"><%= l(:re_setting_enabled_hint) %></em>
  </p>
  <p>
    <label for="merge_live_edits"><%= l(:re_setting_merge) %></label>
    <%= hidden_field_tag 'settings[merge_live_edits]', '0', id: nil %>
    <%= check_box_tag 'settings[merge_live_edits]', '1', settings['merge_live_edits'].to_s != '0' %>
    <em class="info"><%= l(:re_setting_merge_hint) %></em>
  </p>
  <p>
    <label for="merge_window_minutes"><%= l(:re_setting_merge_window) %></label>
    <%# Efektívna hodnota, nie len `settings[...]`. Redmine posiela do partialu ULOŽENÝ hash
        z DB a `merge_window_minutes` v ňom na našich instanciách chýba — políčko by potom
        ukazovalo niečo iné, než čo reálne platí (rovnaká pasca ako v ai_assistant 0.6.4). %>
    <%= text_field_tag 'settings[merge_window_minutes]',
                       (RichEditor::LiveMerge.window.to_i / 60).to_s, size: 4 %>
    <em class="info"><%= l(:re_setting_merge_window_hint) %></em>
  </p>
</div>
